# Anthropic — dispatch routing brain
ANTHROPIC_API_KEY=your_key_here

# ElevenLabs — speech-to-text + text-to-speech
ELEVENLABS_API_KEY=your_key_here

# Session signing secret — HMAC key for the login cookie. Set any long random
# string in production. Falls back to a demo constant if unset.
SESSION_SECRET=

# Upstash Redis (optional) — live request persistence.
# If unset, Üchá falls back to in-memory state. Add these to persist the
# board across refreshes / devices. Provision via the Vercel Marketplace
# (Upstash Redis) or upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

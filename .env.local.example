# Anthropic — dispatch routing brain
ANTHROPIC_API_KEY=your_key_here

# ElevenLabs — speech-to-text + text-to-speech
ELEVENLABS_API_KEY=your_key_here

# Session signing secret — HMAC key for the login cookie. Set any long random
# string in production. Falls back to a demo constant if unset.
SESSION_SECRET=

# Microsoft Teams — Incoming Webhook URL for dispatch notifications.
# Leave blank to disable. Set via Teams channel → Connectors → Incoming Webhook.
TEAMS_WEBHOOK_URL=

# Upstash Redis — shared dispatch-board persistence.
# Required in production: without it the board is a per-process temp file, so
# tickets created by one user are invisible to others. With it, the board is a
# single shared store. Provision via the Vercel Marketplace (Upstash Redis) or
# upstash.com. Local dev works without these (falls back to the temp file).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
